<?xml version="1.0" encoding="utf-8"?>
<!-- Kartu widget: bayangan keras digeser 3dp di belakang kotak bergaris. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="3dp" android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/widget_bayangan_gelap" />
        </shape>
    </item>
    <item android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/widget_kartu_gelap" />
            <stroke android:width="2dp" android:color="@color/widget_garis_gelap" />
        </shape>
    </item>
</layer-list>
