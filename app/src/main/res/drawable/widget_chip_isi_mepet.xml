<?xml version="1.0" encoding="utf-8"?>
<!-- Isi chip widget berwarna status (tetap), 2dp di dalam lapis garis. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="2dp">
    <shape android:shape="rectangle">
        <corners android:radius="6dp" />
        <gradient android:angle="270" android:startColor="#FFE79A" android:endColor="#FFD45C" />
    </shape>
</inset>
